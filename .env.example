# Skopiuj do .env i uzupełnij. Używane przez docker compose oraz npm start.
# Hasło: min. 12 znaków, w pojedynczych cudzysłowach, jeśli zawiera # lub $.
ADMIN_PASSWORD='zmien-to-na-dlugie-prywatne-haslo'
# Adres osiągalny dla uczestników, bez ścieżki. W Internecie użyj HTTPS.
PUBLIC_BASE_URL=http://localhost:3000
# Opcjonalnie: zaufane adresy reverse proxy, oddzielone przecinkami.
TRUST_PROXY=
